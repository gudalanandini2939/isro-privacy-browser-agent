{
"manifest_version": 3,
"name": "ISRO Privacy Browser Agent",
"version": "1.0",
"description": "Privacy-first browser agent prototype",
"permissions": ["activeTab", "scripting", "storage"],
"host_permissions": ["<all_urls>", "http://127.0.0.1:8000/*"],
"action": {"default_popup": "popup.html"},
"content_scripts": [{
"matches": ["<all_urls>"],
"js": ["content.js"]
}]
}